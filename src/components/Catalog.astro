---
import type { Product } from '../lib/products';
import { CATEGORIES, CATEGORY_LABELS } from '../lib/product-schema';
import { site } from '../site';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const countFor = (category: string) => products.filter((product) => product.category === category).length;
const tabs = [
  { value: 'all', label: 'All', count: products.length },
  ...CATEGORIES.map((category) => ({ value: category, label: CATEGORY_LABELS[category], count: countFor(category) })),
];
---

<section id="shop" class="section" data-catalog>
  <div class="container">
    <header class="header" data-reveal>
      <p class="eyebrow">The shop</p>
      <h2 class="section-title">Grab a shortcut for your next edit</h2>
      <p class="section-lead">
        Every download works the moment you buy it. Pick a category or scroll through everything.
      </p>
    </header>

    <div class="tabs" role="group" aria-label="Filter products by category">
      {
        tabs.map((tab) => (
          <button type="button" class="tab" data-filter-tab={tab.value} aria-pressed={tab.value === 'all' ? 'true' : 'false'}>
            {tab.label}
            <span class="count">{tab.count}</span>
          </button>
        ))
      }
    </div>

    <ul class="grid" role="list">
      {
        products.map((product, index) => (
          <li data-category={product.category} data-reveal style={`--reveal-index: ${index % 3}`}>
            <ProductCard product={product} />
          </li>
        ))
      }
    </ul>

    <p class="empty" data-empty-state hidden>Nothing in this category yet. New drops land here first, so check back soon.</p>

    {
      site.payhipStoreUrl && (
        <div class="more">
          <a class="btn btn-ghost" href={site.payhipStoreUrl}>
            See everything on Payhip
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  import '../scripts/filter';
  import '../scripts/preview-video';
</script>

<style>
  .header {
    margin-bottom: var(--space-8);
  }

  .tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
  }

  :global(html:not(.js)) .tabs {
    display: none;
  }

  .tab {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-4);
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .tab:hover {
    background: var(--surface-2);
  }

  .tab:active {
    transform: scale(0.96);
  }

  .tab[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .count {
    min-width: var(--space-6);
    padding-inline: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--surface-3);
    color: var(--text);
    font-size: var(--text-xs);
    text-align: center;
  }

  .tab[aria-pressed='true'] .count {
    background: var(--accent-ink);
    color: var(--accent);
  }

  .grid {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty {
    padding: var(--space-12) var(--space-6);
    border: var(--hairline) dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--muted);
    text-align: center;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-12);
  }
</style>
