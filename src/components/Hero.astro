---
const words = ['Edits', 'that', 'stop', 'the', 'scroll.'];
const tracks = [
  { label: 'V2', clips: [{ start: 8, width: 22, tone: 'accent' }, { start: 52, width: 30, tone: 'glow' }] },
  { label: 'V1', clips: [{ start: 0, width: 40, tone: 'surface' }, { start: 42, width: 26, tone: 'surface' }, { start: 70, width: 30, tone: 'surface' }] },
  { label: 'A1', clips: [{ start: 0, width: 100, tone: 'wave' }] },
];
---

<section id="top" class="hero" data-hero>
  <div class="blobs" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
  </div>

  <div class="container hero-inner">
    <div data-hero-title>
      <p class="eyebrow">MOGRTs · Templates · Creator business kits</p>
      <h1 class="title">
        {
          words.map((word, index) => (
            <span class="word">
              <span class:list={['word-inner', { highlight: index === words.length - 1 }]} style={`--word-index: ${index}`}>
                {word}
              </span>
            </span>
          ))
        }
      </h1>
      <p class="lead">
        Motion graphics, trackers and templates for short-form editors and creators. Buy it, download it, use it in
        today's edit.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#shop">Shop the drops</a>
        <a class="btn btn-ghost" href="#how">How it works</a>
      </div>
    </div>

    <div class="timeline" aria-hidden="true" data-hero-timeline>
      <div class="timeline-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="timecode">00:00:12:08</span>
      </div>
      <div class="tracks">
        {
          tracks.map((track) => (
            <div class="track">
              <span class="track-label">{track.label}</span>
              <div class="lane">
                {track.clips.map((clip) => (
                  <span class={`clip clip-${clip.tone}`} style={`--start: ${clip.start}%; --width: ${clip.width}%`} />
                ))}
              </div>
            </div>
          ))
        }
        <span class="playhead-rail"><span class="playhead-sweep"><span class="playhead"></span></span></span>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-16) var(--space-24);
  }

  .blobs {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .blob {
    position: absolute;
    width: var(--blob-size);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    filter: blur(var(--blur-blob));
    opacity: 0.45;
    will-change: transform;
  }

  .blob-a {
    top: -30%;
    left: -20%;
    background: var(--glow);
    animation: drift-a var(--dur-ambient) var(--ease-snap) infinite alternate;
  }

  .blob-b {
    bottom: -45%;
    right: -25%;
    background: var(--accent);
    opacity: 0.18;
    animation: drift-b var(--dur-ambient) var(--ease-snap) infinite alternate;
  }

  .hero-inner {
    display: grid;
    gap: var(--space-16);
  }

  .title {
    margin-block: var(--space-4) var(--space-6);
    font-size: var(--text-hero);
    font-weight: 800;
    text-transform: uppercase;
  }

  /* Padding gives glyphs room inside the clipping mask; the matching negative margin keeps layout unchanged. */
  .word {
    display: inline-block;
    overflow: hidden;
    padding: 0 0.06em 0.08em;
    margin: 0 calc(0.24em - 0.06em) -0.08em -0.06em;
    vertical-align: top;
  }

  .word-inner {
    display: inline-block;
    animation: word-in var(--dur-slow) var(--ease-out) both;
    animation-delay: calc(120ms + var(--word-index) * 90ms);
  }

  .highlight {
    color: var(--accent);
    font-style: italic;
  }

  .lead {
    max-width: 48ch;
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .timeline {
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-glow);
    overflow: hidden;
  }

  .timeline-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--hairline) solid var(--border);
  }

  .dot {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--surface-3);
  }

  .timecode {
    margin-left: auto;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .tracks {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .track {
    display: grid;
    grid-template-columns: var(--space-8) 1fr;
    align-items: center;
    gap: var(--space-3);
  }

  .track-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--muted);
  }

  .lane {
    position: relative;
    height: var(--space-8);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .clip {
    position: absolute;
    top: var(--space-1);
    bottom: var(--space-1);
    left: var(--start);
    width: calc(var(--width) - var(--space-1));
    border-radius: var(--radius-sm);
  }

  .clip-accent {
    background: var(--accent);
  }

  .clip-glow {
    background: var(--glow);
  }

  .clip-surface {
    background: var(--surface-3);
  }

  .clip-wave {
    background: repeating-linear-gradient(
      90deg,
      var(--glow-soft) 0 var(--space-1),
      transparent var(--space-1) var(--space-2)
    );
  }

  .playhead-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--space-4) + var(--space-8) + var(--space-3));
    right: var(--space-4);
    overflow: hidden;
  }

  .playhead-sweep {
    position: absolute;
    inset: 0;
    animation: scrub var(--dur-scrub) linear infinite;
  }

  .playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: var(--stroke);
    background: var(--accent);
    box-shadow: var(--shadow-accent);
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: var(--space-24) var(--space-32);
    }

    .hero-inner {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
    }
  }

  @keyframes word-in {
    from {
      transform: translateY(105%) skewY(8deg);
    }
  }

  @keyframes drift-a {
    to {
      transform: translate(20%, 25%) scale(1.15);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate(-25%, -15%) scale(0.9);
    }
  }

  @keyframes scrub {
    from {
      transform: translateX(-100%);
    }
  }
</style>
