---
const items = ['Caption packs', 'Kinetic titles', 'Transitions', 'Client trackers', 'Brand-deal kits', 'Invoices & contracts', 'AI tools soon'];
---

<div class="marquee-clip">
<div class="marquee" role="presentation">
  <div class="track">
    {
      [0, 1].map((copy) => (
        <ul class="group" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li>
              {item}
              <span class="star" aria-hidden="true">
                ✦
              </span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
</div>

<style>
  /* The band is tilted, so its corners poke past the viewport; clip them here instead of letting the page scroll sideways. */
  .marquee-clip {
    overflow: hidden;
    padding-block: var(--space-6);
  }

  .marquee {
    overflow: hidden;
    background: var(--accent);
    color: var(--accent-ink);
    transform: rotate(-1.5deg) scale(1.02);
    border-block: var(--hairline) solid var(--accent-ink);
  }

  .track {
    display: flex;
    width: max-content;
    animation: slide var(--dur-marquee) linear infinite;
  }

  .group {
    display: flex;
    gap: var(--space-8);
    padding: var(--space-4) var(--space-4);
    padding-right: var(--space-8);
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
